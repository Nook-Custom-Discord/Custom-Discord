{
  "name": "nook",
  "version": "1.4.3",
  "description": "Private Chat-, Sprach- und Stream-App für deine Freundesgruppe",
  "main": "main.js",
  "scripts": {
    "build:ui": "node build-ui.js",
    "watch:ui": "node build-ui.js --watch",
    "icon": "node build/make-icon.js",
    "start": "npm run build:ui && electron .",
    "server": "node server/cli.js",
    "dist:win": "npm run build:ui && electron-builder --win --publish never",
    "dist:mac": "npm run build:ui && electron-builder --mac --publish never",
    "dist:linux": "npm run build:ui && electron-builder --linux --publish never",
    "deploy": "npm run build:ui && node scripts/deploy-ui.js",
    "mobile:prepare": "npm run build:ui && node scripts/prepare-mobile.js"
  },
  "author": "Alessandro",
  "license": "MIT",
  "dependencies": {
    "express": "^4.22.3",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/ios": "^8.6.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "nook-call": "file:native/nook-call",
    "ogg-opus-decoder": "1.6.16",
    "preact": "^10.29.8",
    "socket.io-client": "^4.8.4"
  },
  "productName": "Nook",
  "build": {
    "appId": "com.nook.app",
    "productName": "Nook",
    "copyright": "Nook – privat & gratis",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "server/**/*",
      "shared/**/*",
      "renderer/index.html",
      "renderer/styles.css",
      "renderer/bundle.js",
      "renderer/opus.js",
      "build/icon.png",
      "package.json",
      "scripts/**/*",
      "renderer/manifest.webmanifest",
      "renderer/sw.js",
      "renderer/icons/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "artifactName": "Nook-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Nook",
      "runAfterFinish": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.social-networking",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "Nook-${version}-mac.${ext}",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Nook braucht dein Mikrofon für Sprachchats und Anrufe.",
        "NSCameraUsageDescription": "Nook braucht deine Kamera für Videoanrufe.",
        "NSScreenCaptureUsageDescription": "Nook braucht die Bildschirmaufnahme, um deinen Bildschirm mit Freunden zu teilen."
      }
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Network"
    }
  }
}
